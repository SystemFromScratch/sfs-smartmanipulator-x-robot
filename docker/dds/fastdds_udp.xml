<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile of the SmartManipulator-X containers: UDPv4 only.

  Fast DDS uses shared memory between participants it believes are on the same
  host. Containers on one computer have separate /dev/shm, so discovery can
  succeed while no data arrives. Disabling the built-in transports keeps all
  traffic on UDP, which is also what the real Robot PC / Operator PC Ethernet
  link carries, so simulation and hardware use the same transport.
-->
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>smx_udpv4</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="smx_udp_only" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>smx_udpv4</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>

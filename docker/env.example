# Template for docker/.env. The defaults below are already built into
# docker/docker-compose*.yml; copy this file to docker/.env only to change
# them (Compose reads .env from the directory of the first compose file).

# Must match the Operator PC. Pick a value no other ROS 2 system on your LAN uses.
ROS_DOMAIN_ID=42

# Virtual "Ethernet" between Robot PC and Operator PC containers.
SMX_SUBNET=10.77.0.0/24
SMX_ROBOT_IP=10.77.0.10

# Local tag; set to ghcr.io/systemfromscratch/sfs-smartmanipulator-x-robot:latest
# to run the image published by CI instead of building it.
SMX_ROBOT_IMAGE=smartmanipulator-x-robot:jazzy

# Serial device on the host, used by docker-compose.hw.yml only.
SMX_SERIAL_DEVICE=/dev/ttyACM0

# SIL (docker-compose.sil.yml): simulated doppelstep drives, host:port in ID order,
# and the joint ID of each drive.
SMX_SIL_DEVICES=host.docker.internal:5555,host.docker.internal:5556,host.docker.internal:5557,host.docker.internal:5558,host.docker.internal:5559,host.docker.internal:5560
SMX_SIL_IDS=1,2,3,4,5,6
# Controller rate in Hz and baud rate passed to the hardware interface in SIL. The read
# timeout of the host is one control period, and a Sync Read of six simulated drives
# (one after the other) takes up to about 60 ms, so keep the rate at 10 or lower.
#SMX_UPDATE_RATE=10
#SMX_BAUD_RATE=9600
# Extra options of the virtual bus. For doppelstep without the X430 emulator 1.1.0:
#SMX_SIL_BUS_ARGS=--fast-read drop --read-order request

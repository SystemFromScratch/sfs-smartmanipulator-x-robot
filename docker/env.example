# Template for docker/.env. The defaults below are already built into
# docker/docker-compose*.yml; copy this file to docker/.env only to change
# them (Compose reads .env from the directory of the first compose file).

# Must match the Operator PC. Pick a value no other ROS 2 system on your LAN uses.
ROS_DOMAIN_ID=42

# Virtual "Ethernet" between Robot PC and Operator PC containers.
SMX_SUBNET=10.77.0.0/24
SMX_ROBOT_IP=10.77.0.10

# Local tag; set to ghcr.io/antonvynohradov/smartmanipulator-x-robot-pc:latest
# to run the image published by CI instead of building it.
SMX_ROBOT_IMAGE=smartmanipulator-x-robot:jazzy

# Host device of the controller, used by docker-compose.hw.yml only.
SMX_SERIAL_DEVICE=/dev/ttyACM0

{
    // Ctrl+Shift+B opens a picker with every task in the "build" group.
    // No task is marked "isDefault", so the picker is always shown.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Robot PC: Start (mock hardware)",
            "detail": "Build the image if needed and run the Robot PC; logs stay in this terminal.",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "up",
                "--build",
                "robot_pc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Robot PC: Stop",
            "detail": "Stop and remove the Robot PC containers and the smx_net network.",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "down"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Robot PC: Rebuild and restart",
            "detail": "Stop, rebuild the image and start the Robot PC again with fresh containers.",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "up",
                "--build",
                "--force-recreate",
                "robot_pc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Robot PC: Stop",
            "group": "build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Robot PC: Build image",
            "detail": "Build the Robot PC image without starting it.",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "build",
                "robot_pc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Robot PC: Rebuild image (no cache)",
            "detail": "Full rebuild from scratch, pulling the base image again. Slow.",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "build",
                "--no-cache",
                "--pull",
                "robot_pc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Robot PC: Smoke test (probe)",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "run",
                "--rm",
                "probe",
                "smx_smoke_test.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Robot PC: Probe shell",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "run",
                "--rm",
                "probe",
                "bash"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Docs: Build PDF manual",
            "detail": "Write the PDF user manual to build/manual/ (needs .venv with requirements-docs.txt).",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "args": [
                "tools/docs/build_manual.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "NO_MKDOCS_2_WARNING": "1"
                }
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Docs: Live preview",
            "detail": "mkdocs serve at http://127.0.0.1:8000",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "args": [
                "-m",
                "mkdocs",
                "serve"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "NO_MKDOCS_2_WARNING": "1"
                }
            },
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}

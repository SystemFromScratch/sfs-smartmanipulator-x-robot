{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docs: Build PDF",
            "type": "process",
            "command": "bash",
            "args": [
                "tools/docs/build_pdf.sh"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "tools/docs/build_pdf.ps1"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docs: Live preview",
            "type": "process",
            "command": "bash",
            "args": [
                "tools/docs/build_pdf.sh",
                "--serve"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "tools/docs/build_pdf.ps1",
                    "-Serve"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Robot PC: Build image",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "build",
                "robot_pc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Robot PC: Start (mock hardware)",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "up",
                "--build",
                "robot_pc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Robot PC: Stop",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "down"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Robot PC: Smoke test (probe)",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "run",
                "--rm",
                "probe",
                "smx_smoke_test.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Robot PC: Probe shell",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker/docker-compose.yml",
                "run",
                "--rm",
                "probe",
                "bash"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}

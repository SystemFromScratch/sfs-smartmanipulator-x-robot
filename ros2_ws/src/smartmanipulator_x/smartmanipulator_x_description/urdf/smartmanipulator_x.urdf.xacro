<?xml version="1.0"?>
<!--
  SmartManipulator-X robot description (BCN3D Moveo mechanics).

  STATUS: PLACEHOLDER KINEMATICS.
  The joint structure (5 revolute axes + gripper) follows the BCN3D Moveo and
  the axis table in docs/hardware/wiring.md. Link lengths, joint origins,
  limits and the visual geometry below are rough placeholders so that
  ros2_control, the controllers and RViz can be brought up. They are NOT
  measured. Replace every value marked TODO(CAD) with data from the Moveo CAD
  files and the assembled arm before planning real motion.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smartmanipulator_x">

  <xacro:arg name="use_mock_hardware" default="true"/>

  <!-- TODO(CAD): all lengths in metres, placeholders. -->
  <xacro:property name="base_height"    value="0.10"/>
  <xacro:property name="shoulder_height" value="0.13"/>
  <xacro:property name="upper_arm"      value="0.22"/>
  <xacro:property name="forearm"        value="0.12"/>
  <xacro:property name="wrist_offset"   value="0.11"/>
  <xacro:property name="tool_length"    value="0.08"/>

  <!-- TODO(CAD/robot): limits are placeholders, not the Moveo's real range. -->
  <xacro:property name="vel_limit"    value="1.0"/>
  <xacro:property name="effort_limit" value="10.0"/>

  <xacro:property name="pi" value="3.141592653589793"/>

  <material name="smx_base"><color rgba="0.20 0.20 0.22 1.0"/></material>
  <material name="smx_link"><color rgba="0.93 0.55 0.15 1.0"/></material>
  <material name="smx_joint"><color rgba="0.35 0.35 0.38 1.0"/></material>

  <xacro:macro name="cyl_link" params="name radius length material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <link name="world"/>

  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:cyl_link name="base_link" radius="0.07" length="${base_height}" material="smx_base"/>

  <!-- J1 base: rotation about the vertical axis. -->
  <joint name="j1_base" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" velocity="${vel_limit}" effort="${effort_limit}"/>
  </joint>

  <xacro:cyl_link name="link1" radius="0.05" length="${shoulder_height}" material="smx_link"/>

  <!-- J2 shoulder: pitch. Driven by two mirrored NEMA23 (DYNAMIXEL IDs 2 and 3). -->
  <joint name="j2_shoulder" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${shoulder_height}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" velocity="${vel_limit}" effort="${effort_limit}"/>
  </joint>

  <xacro:cyl_link name="link2" radius="0.035" length="${upper_arm}" material="smx_link"/>

  <!-- J3 elbow: pitch. -->
  <joint name="j3_elbow" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${upper_arm}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" velocity="${vel_limit}" effort="${effort_limit}"/>
  </joint>

  <xacro:cyl_link name="link3" radius="0.03" length="${forearm}" material="smx_link"/>

  <!-- J4 forearm roll: rotation about the forearm axis. -->
  <joint name="j4_forearm_roll" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 ${forearm}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" velocity="${vel_limit}" effort="${effort_limit}"/>
  </joint>

  <xacro:cyl_link name="link4" radius="0.025" length="${wrist_offset}" material="smx_joint"/>

  <!-- J5 wrist: pitch. -->
  <joint name="j5_wrist" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 ${wrist_offset}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" velocity="${vel_limit}" effort="${effort_limit}"/>
  </joint>

  <xacro:cyl_link name="link5" radius="0.02" length="${tool_length}" material="smx_joint"/>

  <!--
    Gripper: one revolute joint for the MG996R servo (DYNAMIXEL ID 7).
    TODO(robot): range and conversion to finger opening after calibration.
  -->
  <joint name="gripper" type="revolute">
    <parent link="link5"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 ${tool_length}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.0" velocity="${vel_limit}" effort="${effort_limit}"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.06 0.02 0.04"/></geometry>
      <material name="smx_base"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="tool_fixed" type="fixed">
    <parent link="gripper_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <link name="tool_link"/>

  <xacro:include filename="$(find smartmanipulator_x_description)/urdf/smartmanipulator_x.ros2_control.xacro"/>
  <xacro:smartmanipulator_x_ros2_control use_mock_hardware="$(arg use_mock_hardware)"/>

</robot>

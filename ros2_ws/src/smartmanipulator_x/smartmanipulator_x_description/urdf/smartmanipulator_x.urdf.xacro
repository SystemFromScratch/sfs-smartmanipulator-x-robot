<?xml version="1.0"?>
<!--
  SmartManipulator-X robot description: BCN3D Moveo mechanics.

  Generated from the BCN3D Moveo CAD assembly (STEP export of
  "BCN3D Moveo assembly.SLDASM", https://github.com/BCN3D/BCN3D-Moveo, MIT
  license, see meshes/LICENSE-BCN3D-Moveo). Joint axes come from the axles in
  the CAD; link meshes are the CAD parts of each link, decimated.

  Zero pose: arm straight up, gripper fully open. Positive J2, J3 and J5 bend
  the arm forward (+x); J1 and J4 turn counter-clockwise seen from the tip of
  their axis. Joint limits are placeholders until measured on the real arm.

  Do not edit by hand: regenerate with tools/cad (see docs/mechanical/index.md).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smartmanipulator_x">

  <xacro:arg name="use_mock_hardware" default="true"/>
  <!-- The electronics box of the original Moveo; off for the SmartFusion2 build. -->
  <xacro:arg name="electronics_box" default="false"/>

  <link name="world"/>

  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/base_printed.stl" scale="1 1 1"/></geometry>
      <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/base_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/base.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <xacro:if value="$(arg electronics_box)">
    <link name="electronics_box">
      <visual>
        <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/ebox_printed.stl" scale="1 1 1"/></geometry>
        <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
      </visual>
      <visual>
        <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/ebox_hardware.stl" scale="1 1 1"/></geometry>
        <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/ebox.stl" scale="1 1 1"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="electronics_box_fixed" type="fixed">
      <parent link="base_link"/>
      <child link="electronics_box"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- J1 base: rotation about the vertical axis -->
  <joint name="j1_base" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" velocity="1.0" effort="10.0"/>
  </joint>

  <link name="link1">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/link1_printed.stl" scale="1 1 1"/></geometry>
      <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/link1_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/link1.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- J2 shoulder: two mirrored motors (DYNAMIXEL IDs 2 and 3); + tilts the arm forward -->
  <joint name="j2_shoulder" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.23164" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" velocity="1.0" effort="10.0"/>
  </joint>

  <link name="link2">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/link2_printed.stl" scale="1 1 1"/></geometry>
      <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/link2_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/link2.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- J3 elbow: + bends forward -->
  <joint name="j3_elbow" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.22112" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" velocity="1.0" effort="10.0"/>
  </joint>

  <link name="link3">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/link3_printed.stl" scale="1 1 1"/></geometry>
      <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/link3_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/link3.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- J4 forearm roll -->
  <joint name="j4_forearm_roll" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.09609" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" velocity="1.0" effort="5.0"/>
  </joint>

  <link name="link4">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/link4_printed.stl" scale="1 1 1"/></geometry>
      <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/link4_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/link4.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- J5 wrist pitch: + bends forward -->
  <joint name="j5_wrist" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.12691" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" velocity="1.0" effort="5.0"/>
  </joint>

  <link name="link5">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/link5_printed.stl" scale="1 1 1"/></geometry>
      <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/link5_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/link5.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!--
    Gripper: the MG996R turns the servo gear (joint "gripper", DYNAMIXEL ID 7).
    The idler gear turns the other way; each finger hangs on a gear arm and a
    pivot arm of the same length (40 mm), a parallelogram, so the fingers keep
    their orientation. 0 = fully open (80 mm between the fingers), 1.45 rad = closed.
    Only "gripper" is commanded; the others are mimic joints.
  -->
  <joint name="gripper" type="revolute">
    <parent link="link5"/>
    <child link="servo_gear"/>
    <origin xyz="0.00047 -0.014 0.065" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.45" velocity="1.0" effort="2.0"/>
  </joint>

  <link name="servo_gear">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/servo_gear_printed.stl" scale="1 1 1"/></geometry>
      <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/servo_gear.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="gripper_idler_gear" type="revolute">
    <parent link="link5"/>
    <child link="idler_gear"/>
    <origin xyz="0.00043 0.014 0.065" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.45" upper="0" velocity="1.0" effort="2.0"/>
    <mimic joint="gripper" multiplier="-1" offset="0"/>
  </joint>

  <link name="idler_gear">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/idler_gear_printed.stl" scale="1 1 1"/></geometry>
      <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/idler_gear_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/idler_gear.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="gripper_pivot_right" type="revolute">
    <parent link="link5"/>
    <child link="pivot_right"/>
    <origin xyz="0.00054 -0.007 0.085" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.45" velocity="1.0" effort="2.0"/>
    <mimic joint="gripper" multiplier="1" offset="0"/>
  </joint>

  <link name="pivot_right">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/pivot_right_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/pivot_right.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="gripper_pivot_left" type="revolute">
    <parent link="link5"/>
    <child link="pivot_left"/>
    <origin xyz="0.00055 0.00701 0.085" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.45" upper="0" velocity="1.0" effort="2.0"/>
    <mimic joint="gripper" multiplier="-1" offset="0"/>
  </joint>

  <link name="pivot_left">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/pivot_left_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/pivot_left.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="gripper_finger_right" type="revolute">
    <parent link="servo_gear"/>
    <child link="finger_right"/>
    <origin xyz="-0.00004 -0.04 -0.00056" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.45" upper="0" velocity="1.0" effort="2.0"/>
    <mimic joint="gripper" multiplier="-1" offset="0"/>
  </joint>

  <link name="finger_right">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/finger_right_printed.stl" scale="1 1 1"/></geometry>
      <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/finger_right_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/finger_right.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="gripper_finger_left" type="revolute">
    <parent link="idler_gear"/>
    <child link="finger_left"/>
    <origin xyz="-0.00003 0.04 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.45" velocity="1.0" effort="2.0"/>
    <mimic joint="gripper" multiplier="1" offset="0"/>
  </joint>

  <link name="finger_left">
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/finger_left_printed.stl" scale="1 1 1"/></geometry>
      <material name="smx_printed"><color rgba="0.82 0.83 0.85 1.0"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/visual/finger_left_hardware.stl" scale="1 1 1"/></geometry>
      <material name="smx_hardware"><color rgba="0.18 0.18 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://smartmanipulator_x_description/meshes/collision/finger_left.stl" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Tool point between the fingertips of the closed gripper -->
  <joint name="tool_fixed" type="fixed">
    <parent link="link5"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="tool_link"/>

  <xacro:include filename="$(find smartmanipulator_x_description)/urdf/smartmanipulator_x.ros2_control.xacro"/>
  <xacro:smartmanipulator_x_ros2_control use_mock_hardware="$(arg use_mock_hardware)"/>

</robot>
